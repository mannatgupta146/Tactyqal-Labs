# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/tactyqal

# Public Client API Endpoint (Render Production API or http://localhost:5000/api for local)
NEXT_PUBLIC_API_URL=https://tactyqal-labs.onrender.com/api

# Allowed Frontend URL for CORS
FRONTEND_URL=https://tactyqal-labs-kappa.vercel.app

# Environment
NODE_ENV=development
