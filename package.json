{
  "name": "tactyqal-labs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "next dev -p 3000",
    "client:build": "next build",
    "client:start": "next start -p 3000",
    "server:dev": "tsx watch backend/server.ts",
    "server:start": "tsx backend/server.ts",
    "seed": "tsx backend/seeds/runSeed.ts",
    "test:api": "tsx backend/test-e2e.ts",
    "build": "next build",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:start\" \"npm run client:start\""
  },
  "dependencies": {
    "@gsap/react": "^2.1.1",
    "@reduxjs/toolkit": "^2.3.0",
    "@tailwindcss/typography": "^0.5.15",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "gsap": "^3.12.5",
    "lucide-react": "^0.454.0",
    "mongoose": "^8.8.0",
    "next": "^14.2.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
